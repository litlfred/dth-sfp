<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:bootstrap.processes="https://litlfred.github.io/bootstrap/v0/processes/ns#"
                  xmlns:cat-harness.processes="https://litlfred.github.io/cat-harness/v0/processes/ns#"
                  id="Definitions_Process_SF_REP_003"
                  targetNamespace="https://litlfred.github.io/dth-sfp/workflows"
                  exporter="folio-assistant" exporterVersion="1">
  <bpmn:import namespace="https://litlfred.github.io/bootstrap/v0/processes/ns#" location="https://litlfred.github.io/bootstrap/v0/processes/ns.jsonld" importType="http://www.w3.org/ns/json-ld"/>
  <bpmn:resource id="pers:sfp-r-01" name="Doctor / Healthcare Professional Reporter (SFP-R-01)"/>
  <bpmn:resource id="pers:sfp-r-02" name="Nurse Reporter (SFP-R-02)"/>
  <bpmn:resource id="pers:sfp-r-03" name="Individual / Patient Reporter (SFP-R-03)"/>
  <bpmn:resource id="pers:sfp-r-04" name="Community Health Worker Reporter (SFP-R-04)"/>
  <bpmn:resource id="pers:sfp-r-05" name="Laboratory Technician (SFP-R-05)"/>
  <bpmn:resource id="pers:sfp-r-06" name="Pharmacist Reporter (SFP-R-06)"/>
  <bpmn:resource id="pers:sfp-r-07" name="Dentist Reporter (SFP-R-07)"/>
  <bpmn:resource id="pers:sfp-r-08" name="Midwife Reporter (SFP-R-08)"/>
  <bpmn:resource id="pers:sfp-r-09" name="Paramedic / Field Reporter (SFP-R-09)"/>
  <bpmn:resource id="pers:sfp-r-10" name="Pharmacy Technician Reporter (SFP-R-10)"/>
  <bpmn:resource id="pers:sfp-r-11" name="Public Health Worker Reporter (SFP-R-11)"/>
  <bpmn:resource id="pers:sfp-r-12" name="Veterinarian Reporter (SFP-R-12)"/>
  <bpmn:resource id="pers:sfp-r-13" name="National Medicines Regulatory Authority (NMRA) Reviewer &amp; Case System (SFP-R-13)"/>
  <bpmn:resource id="pers:sfp-r-14" name="Pharmaceutical Manufacturer / Supplier / Supply Chain Actor (SFP-R-14)"/>
  <bpmn:resource id="pers:sfp-r-15" name="Governance, Law Enforcement &amp; Global Surveillance (WHO GSMS) Actor (SFP-R-15)"/>
  <bpmn:collaboration id="Collaboration_Process_SF_REP_003">
    <bpmn:participant id="Participant_Process_SF_REP_003" name="SF-REP-003: Investigate SF report and test samples" processRef="Process_SF_REP_003"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_SF_REP_003" name="SF-REP-003: Investigate SF report and test samples" isExecutable="false">
    <bpmn:documentation>Workflow for regulatory investigation, reporter follow-up, physical sample collection, and quality control laboratory testing, formalised from §1.3 (page 11 / PDF page 23), §2.2 (page 15 / PDF page 27), Table 7 SFP-R-05 (Laboratory technician, page 25 / PDF page 37), and Table 9 scenario 5 (page 28 / PDF page 40).</bpmn:documentation>
    <bpmn:extensionElements>
      <cat-harness.processes:policy enforcement="advisory"/>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_Process_SF_REP_003">
      <bpmn:lane id="Lane_SF_REP_003_Reporter" name="Reporter (SFP-R-01..12)" partitionElementRef="pers:sfp-r-01">
        <bpmn:documentation>Personas pers:sfp-r-01..pers:sfp-r-12. Provides follow-up clinical/supply details or physical sample when contact information was provided.</bpmn:documentation>
        <bpmn:flowNodeRef>Task_304_ProvideFollowUp</bpmn:flowNodeRef>
        <bpmn:childLaneSet id="ChildLaneSet_Lane_SF_REP_003_Reporter">
          <bpmn:lane id="Lane_SF_REP_003_R02" name="Nurse Reporter (SFP-R-02)" partitionElementRef="pers:sfp-r-02"/>
          <bpmn:lane id="Lane_SF_REP_003_R03" name="Patient / Individual Reporter (SFP-R-03)" partitionElementRef="pers:sfp-r-03"/>
        </bpmn:childLaneSet>
      </bpmn:lane>
      <bpmn:lane id="Lane_SF_REP_003_NMRA" name="NMRA Reviewer &amp; Inspectorate (SFP-R-13)" partitionElementRef="pers:sfp-r-13">
        <bpmn:documentation>Persona pers:sfp-r-13. Evaluates dossier, requests follow-up when contact details exist, dispatches samples to QC lab, and adjudicates findings.</bpmn:documentation>
        <bpmn:flowNodeRef>Start_SF_REP_003</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_301_ReviewDossier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_301_HasContact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_302_RequestFollowUp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_303_DispatchSampleToLab</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_306_EvaluateLabFindings</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_SF_REP_003</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SF_REP_003_Lab" name="Quality Control Laboratory (SFP-R-05)" partitionElementRef="pers:sfp-r-05">
        <bpmn:documentation>Persona pers:sfp-r-05 (Laboratory technician, Table 7 / Table 9 scenario 5). Performs compendial/analytical testing and issues certificate of analysis.</bpmn:documentation>
        <bpmn:flowNodeRef>Task_305_PerformLabAnalysis</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:userTask id="Task_304_ProvideFollowUp" name="Provide follow-up details or physical sample">
      <bpmn:documentation>Reporter provides additional product/clinical details or hands over the physical sample for inspection.</bpmn:documentation>
      <bpmn:extensionElements>
        <cat-harness.processes:no-skill reason="Domain step from WHO DTH for Substandard and Falsified Medical Product Reporting Systems (9789240120747-eng)"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_304</bpmn:incoming>
      <bpmn:outgoing>Flow_305</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:startEvent id="Start_SF_REP_003" name="Triaged report requires investigation">
      <bpmn:documentation>Triggered when a screened SF report requires regulatory investigation and laboratory verification.</bpmn:documentation>
      <bpmn:outgoing>Flow_301</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_301_ReviewDossier" name="Examine SF report, photos &amp; batch history">
      <bpmn:documentation>Inspect submitted report details (DE1-DE10), attached photographs, and linked batch complaints (SFR.FXNREQ.010-012).</bpmn:documentation>
      <bpmn:extensionElements>
        <cat-harness.processes:no-skill reason="Domain step from WHO DTH for Substandard and Falsified Medical Product Reporting Systems (9789240120747-eng)"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_301</bpmn:incoming>
      <bpmn:outgoing>Flow_302</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_301_HasContact" name="Reporter contact available (DE10)?">
      <bpmn:documentation>Check whether reporter contact information (SFR.A1.DE10) is available for follow-up inquiry.</bpmn:documentation>
      <bpmn:incoming>Flow_302</bpmn:incoming>
      <bpmn:outgoing>Flow_303_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_303_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_302_RequestFollowUp" name="Request follow-up details or sample">
      <bpmn:documentation>Contact the reporter to request clarifying information or physical sample collection.</bpmn:documentation>
      <bpmn:extensionElements>
        <cat-harness.processes:no-skill reason="Domain step from WHO DTH for Substandard and Falsified Medical Product Reporting Systems (9789240120747-eng)"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_303_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_304</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_303_DispatchSampleToLab" name="Collect sample &amp; dispatch to QC lab">
      <bpmn:documentation>Obtain field/facility sample and dispatch under chain of custody to the quality control testing laboratory.</bpmn:documentation>
      <bpmn:extensionElements>
        <cat-harness.processes:no-skill reason="Domain step from WHO DTH for Substandard and Falsified Medical Product Reporting Systems (9789240120747-eng)"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_303_No</bpmn:incoming>
      <bpmn:incoming>Flow_305</bpmn:incoming>
      <bpmn:outgoing>Flow_306</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_306_EvaluateLabFindings" name="Evaluate lab certificate &amp; confirm status">
      <bpmn:documentation>Review laboratory analytical report and classify product as confirmed substandard, confirmed falsified, or compliant.</bpmn:documentation>
      <bpmn:extensionElements>
        <cat-harness.processes:no-skill reason="Domain step from WHO DTH for Substandard and Falsified Medical Product Reporting Systems (9789240120747-eng)"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_307</bpmn:incoming>
      <bpmn:outgoing>Flow_308</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_SF_REP_003" name="Investigation concluded">
      <bpmn:documentation>Investigation record completed and routed for regulatory action if confirmed.</bpmn:documentation>
      <bpmn:incoming>Flow_308</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_305_PerformLabAnalysis" name="Test sample identity, assay &amp; packaging">
      <bpmn:documentation>Perform physical, chemical, or microbiological analysis of the suspected product sample and record analytical findings.</bpmn:documentation>
      <bpmn:extensionElements>
        <cat-harness.processes:no-skill reason="Domain step from WHO DTH for Substandard and Falsified Medical Product Reporting Systems (9789240120747-eng)"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_306</bpmn:incoming>
      <bpmn:outgoing>Flow_307</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_301" sourceRef="Start_SF_REP_003" targetRef="Task_301_ReviewDossier"/>
    <bpmn:sequenceFlow id="Flow_302" sourceRef="Task_301_ReviewDossier" targetRef="Gw_301_HasContact"/>
    <bpmn:sequenceFlow id="Flow_303_Yes" sourceRef="Gw_301_HasContact" targetRef="Task_302_RequestFollowUp" name="Yes"/>
    <bpmn:sequenceFlow id="Flow_303_No" sourceRef="Gw_301_HasContact" targetRef="Task_303_DispatchSampleToLab" name="Anonymous"/>
    <bpmn:sequenceFlow id="Flow_304" sourceRef="Task_302_RequestFollowUp" targetRef="Task_304_ProvideFollowUp"/>
    <bpmn:sequenceFlow id="Flow_305" sourceRef="Task_304_ProvideFollowUp" targetRef="Task_303_DispatchSampleToLab"/>
    <bpmn:sequenceFlow id="Flow_306" sourceRef="Task_303_DispatchSampleToLab" targetRef="Task_305_PerformLabAnalysis"/>
    <bpmn:sequenceFlow id="Flow_307" sourceRef="Task_305_PerformLabAnalysis" targetRef="Task_306_EvaluateLabFindings"/>
    <bpmn:sequenceFlow id="Flow_308" sourceRef="Task_306_EvaluateLabFindings" targetRef="End_SF_REP_003"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_SF_REP_003">
    <bpmndi:BPMNPlane id="BPMNPlane_Process_SF_REP_003" bpmnElement="Collaboration_Process_SF_REP_003">
      <bpmndi:BPMNShape id="Shape_Participant_Process_SF_REP_003" bpmnElement="Participant_Process_SF_REP_003" isHorizontal="true">
        <dc:Bounds x="20" y="60" width="1320" height="640"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_SF_REP_003_Reporter" bpmnElement="Lane_SF_REP_003_Reporter" isHorizontal="true">
        <dc:Bounds x="50" y="60" width="1290" height="200"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_SF_REP_003_NMRA" bpmnElement="Lane_SF_REP_003_NMRA" isHorizontal="true">
        <dc:Bounds x="50" y="260" width="1290" height="240"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_SF_REP_003_Lab" bpmnElement="Lane_SF_REP_003_Lab" isHorizontal="true">
        <dc:Bounds x="50" y="500" width="1290" height="200"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_304_ProvideFollowUp" bpmnElement="Task_304_ProvideFollowUp">
        <dc:Bounds x="575" y="115" width="155" height="86"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_SF_REP_003" bpmnElement="Start_SF_REP_003">
        <dc:Bounds x="110" y="362" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="86" y="406" width="95" height="40"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_301_ReviewDossier" bpmnElement="Task_301_ReviewDossier">
        <dc:Bounds x="185" y="337" width="155" height="86"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gw_301_HasContact" bpmnElement="Gw_301_HasContact">
        <dc:Bounds x="375" y="355" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="335" y="295" width="130" height="38"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_302_RequestFollowUp" bpmnElement="Task_302_RequestFollowUp">
        <dc:Bounds x="475" y="337" width="155" height="86"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_303_DispatchSampleToLab" bpmnElement="Task_303_DispatchSampleToLab">
        <dc:Bounds x="765" y="337" width="155" height="86"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_306_EvaluateLabFindings" bpmnElement="Task_306_EvaluateLabFindings">
        <dc:Bounds x="1060" y="337" width="155" height="86"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_SF_REP_003" bpmnElement="End_SF_REP_003">
        <dc:Bounds x="1255" y="362" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1220" y="406" width="105" height="36"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_305_PerformLabAnalysis" bpmnElement="Task_305_PerformLabAnalysis">
        <dc:Bounds x="910" y="555" width="155" height="86"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_301" bpmnElement="Flow_301">
        <di:waypoint x="146" y="380"/>
        <di:waypoint x="185" y="380"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_302" bpmnElement="Flow_302">
        <di:waypoint x="340" y="380"/>
        <di:waypoint x="375" y="380"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_303_Yes" bpmnElement="Flow_303_Yes">
        <di:waypoint x="425" y="380"/>
        <di:waypoint x="475" y="380"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="432" y="352" width="35" height="20"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_303_No" bpmnElement="Flow_303_No">
        <di:waypoint x="400" y="405"/>
        <di:waypoint x="400" y="462"/>
        <di:waypoint x="795" y="462"/>
        <di:waypoint x="795" y="423"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="410" y="468" width="75" height="20"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_304" bpmnElement="Flow_304">
        <di:waypoint x="552" y="337"/>
        <di:waypoint x="552" y="158"/>
        <di:waypoint x="575" y="158"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_305" bpmnElement="Flow_305">
        <di:waypoint x="730" y="158"/>
        <di:waypoint x="842" y="158"/>
        <di:waypoint x="842" y="337"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_306" bpmnElement="Flow_306">
        <di:waypoint x="870" y="423"/>
        <di:waypoint x="870" y="598"/>
        <di:waypoint x="910" y="598"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_307" bpmnElement="Flow_307">
        <di:waypoint x="1065" y="598"/>
        <di:waypoint x="1138" y="598"/>
        <di:waypoint x="1138" y="423"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_308" bpmnElement="Flow_308">
        <di:waypoint x="1215" y="380"/>
