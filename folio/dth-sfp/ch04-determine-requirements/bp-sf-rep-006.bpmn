<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:bootstrap.processes="https://litlfred.github.io/bootstrap/v0/processes/ns#"
                  xmlns:cat-harness.processes="https://litlfred.github.io/cat-harness/v0/processes/ns#"
                  id="Definitions_Process_SF_REP_006"
                  targetNamespace="https://litlfred.github.io/dth-sfp/workflows"
                  exporter="folio-assistant" exporterVersion="1">
  <bpmn:import namespace="https://litlfred.github.io/bootstrap/v0/processes/ns#" location="https://litlfred.github.io/bootstrap/v0/processes/ns.jsonld" importType="http://www.w3.org/ns/json-ld"/>
  <bpmn:resource id="sfp-r-01" name="Doctor / Healthcare Professional Reporter (SFP-R-01)"/>
  <bpmn:resource id="sfp-r-02" name="Nurse Reporter (SFP-R-02)"/>
  <bpmn:resource id="sfp-r-03" name="Individual / Patient Reporter (SFP-R-03)"/>
  <bpmn:resource id="sfp-r-04" name="Community Health Worker Reporter (SFP-R-04)"/>
  <bpmn:resource id="sfp-r-05" name="Laboratory Technician (SFP-R-05)"/>
  <bpmn:resource id="sfp-r-06" name="Pharmacist Reporter (SFP-R-06)"/>
  <bpmn:resource id="sfp-r-07" name="Dentist Reporter (SFP-R-07)"/>
  <bpmn:resource id="sfp-r-08" name="Midwife Reporter (SFP-R-08)"/>
  <bpmn:resource id="sfp-r-09" name="Paramedic / Field Reporter (SFP-R-09)"/>
  <bpmn:resource id="sfp-r-10" name="Pharmacy Technician Reporter (SFP-R-10)"/>
  <bpmn:resource id="sfp-r-11" name="Public Health Worker Reporter (SFP-R-11)"/>
  <bpmn:resource id="sfp-r-12" name="Veterinarian Reporter (SFP-R-12)"/>
  <bpmn:resource id="sfp-r-13" name="National Medicines Regulatory Authority (NMRA) Reviewer &amp; Case System (SFP-R-13)"/>
  <bpmn:resource id="sfp-r-14" name="Pharmaceutical Manufacturer / Supplier / Supply Chain Actor (SFP-R-14)"/>
  <bpmn:resource id="sfp-r-15" name="Governance, Law Enforcement &amp; Global Surveillance (WHO GSMS) Actor (SFP-R-15)"/>
  <bpmn:collaboration id="Collaboration_Process_SF_REP_006">
    <bpmn:participant id="Participant_Process_SF_REP_006" name="Submit SF report offline and synchronise (SF-REP-006)" processRef="Process_SF_REP_006"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_SF_REP_006" name="Submit SF report offline and synchronise (SF-REP-006)" isExecutable="false">
    <bpmn:documentation>Subprocess of SF-REP-001 for capturing an SF report in low- or no-connectivity settings, queuing it in a local encrypted outbox, and synchronising automatically when connectivity is restored, drafted from Table 9 scenario 9 (Paramedic, p. 28 / PDF p. 40), Table 13 offline capability requirements (pp. 32-34 / PDF pp. 44-46), and Ch. 7 outbox implementation note (p. 47 / PDF p. 59).</bpmn:documentation>
    <bpmn:extensionElements>
      <cat-harness.processes:policy enforcement="advisory"/>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_Process_SF_REP_006">
      <bpmn:lane id="Lane_SF_REP_006_Reporter" name="Paramedic / Field Reporter in Low-Connectivity Area (SFP-R-09)" partitionElementRef="sfp-r-09">
        <bpmn:documentation>Persona pers:sfp-r-09 (Paramedic / field health worker). Captures SF report and product photos while offline.</bpmn:documentation>
        <bpmn:flowNodeRef>Start_SF_REP_006</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_601_CompleteOfflineForm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_602_SaveToOutbox</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SF_REP_006_App" name="SF Reporting App Offline Outbox &amp; NMRA Sync Service (SFP-R-13)" partitionElementRef="sfp-r-13">
        <bpmn:documentation>Persona pers:sfp-r-13 (SF Reporting POS App &amp; Server). Queues report locally, detects connectivity, uploads to NMRA server, and delivers tracking number.</bpmn:documentation>
        <bpmn:flowNodeRef>Task_603_QueueEncryptedOutbox</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_601_NetworkAvailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_604_SyncToNMRAServer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_605_DeliverConfirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_SF_REP_006</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_SF_REP_006" name="Detect suspect product without network connectivity">
      <bpmn:outgoing>Flow_601</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_601_CompleteOfflineForm" name="Complete SF report form (DE1-DE10) &amp; attach photos in offline mode">
      <bpmn:incoming>Flow_601</bpmn:incoming>
      <bpmn:outgoing>Flow_602</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_602_SaveToOutbox" name="Submit report to local encrypted device outbox">
      <bpmn:incoming>Flow_602</bpmn:incoming>
      <bpmn:outgoing>Flow_603</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_603_QueueEncryptedOutbox" name="Store report &amp; attachments in local outbox queue (Table 13 offline NFR)">
      <bpmn:incoming>Flow_603</bpmn:incoming>
      <bpmn:incoming>Flow_605_Wait</bpmn:incoming>
      <bpmn:outgoing>Flow_604</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_601_NetworkAvailable" name="Network connectivity restored?">
      <bpmn:incoming>Flow_604</bpmn:incoming>
      <bpmn:outgoing>Flow_605_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_605_Wait</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_604_SyncToNMRAServer" name="Synchronise queued SF report to NMRA server &amp; trigger SF-REP-002">
      <bpmn:incoming>Flow_605_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_606</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_605_DeliverConfirmation" name="Update local status &amp; display assigned tracking number to reporter">
      <bpmn:incoming>Flow_606</bpmn:incoming>
      <bpmn:outgoing>Flow_607</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_SF_REP_006" name="Offline SF report synchronised &amp; acknowledged">
      <bpmn:incoming>Flow_607</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_601" sourceRef="Start_SF_REP_006" targetRef="Task_601_CompleteOfflineForm"/>
    <bpmn:sequenceFlow id="Flow_602" sourceRef="Task_601_CompleteOfflineForm" targetRef="Task_602_SaveToOutbox"/>
    <bpmn:sequenceFlow id="Flow_603" sourceRef="Task_602_SaveToOutbox" targetRef="Task_603_QueueEncryptedOutbox"/>
    <bpmn:sequenceFlow id="Flow_604" sourceRef="Task_603_QueueEncryptedOutbox" targetRef="Gw_601_NetworkAvailable"/>
    <bpmn:sequenceFlow id="Flow_605_Yes" sourceRef="Gw_601_NetworkAvailable" targetRef="Task_604_SyncToNMRAServer" name="Online"/>
    <bpmn:sequenceFlow id="Flow_605_Wait" sourceRef="Gw_601_NetworkAvailable" targetRef="Task_603_QueueEncryptedOutbox" name="Offline (retain in outbox)"/>
    <bpmn:sequenceFlow id="Flow_606" sourceRef="Task_604_SyncToNMRAServer" targetRef="Task_605_DeliverConfirmation"/>
    <bpmn:sequenceFlow id="Flow_607" sourceRef="Task_605_DeliverConfirmation" targetRef="End_SF_REP_006"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_SF_REP_006">
    <bpmndi:BPMNPlane id="BPMNPlane_Process_SF_REP_006" bpmnElement="Collaboration_Process_SF_REP_006">
      <bpmndi:BPMNShape id="Shape_Participant_Process_SF_REP_006" bpmnElement="Participant_Process_SF_REP_006" isHorizontal="true">
        <dc:Bounds x="20" y="80" width="1180" height="360"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_SF_REP_006_Reporter" bpmnElement="Lane_SF_REP_006_Reporter" isHorizontal="true">
        <dc:Bounds x="40" y="80" width="1160" height="180"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_SF_REP_006_App" bpmnElement="Lane_SF_REP_006_App" isHorizontal="true">
        <dc:Bounds x="40" y="260" width="1160" height="180"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_SF_REP_006" bpmnElement="Start_SF_REP_006">
        <dc:Bounds x="180" y="152" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_601_CompleteOfflineForm" bpmnElement="Task_601_CompleteOfflineForm">
        <dc:Bounds x="350" y="135" width="130" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_602_SaveToOutbox" bpmnElement="Task_602_SaveToOutbox">
        <dc:Bounds x="520" y="135" width="130" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_603_QueueEncryptedOutbox" bpmnElement="Task_603_QueueEncryptedOutbox">
        <dc:Bounds x="180" y="315" width="130" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gw_601_NetworkAvailable" bpmnElement="Gw_601_NetworkAvailable">
        <dc:Bounds x="350" y="325" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_604_SyncToNMRAServer" bpmnElement="Task_604_SyncToNMRAServer">
        <dc:Bounds x="520" y="315" width="130" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_605_DeliverConfirmation" bpmnElement="Task_605_DeliverConfirmation">
        <dc:Bounds x="690" y="315" width="130" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_SF_REP_006" bpmnElement="End_SF_REP_006">
        <dc:Bounds x="860" y="332" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_601" bpmnElement="Flow_601">
        <di:waypoint x="216" y="170"/>
        <di:waypoint x="350" y="170"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_602" bpmnElement="Flow_602">
        <di:waypoint x="480" y="170"/>
        <di:waypoint x="520" y="170"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_603" bpmnElement="Flow_603">
        <di:waypoint x="650" y="170"/>
        <di:waypoint x="180" y="350"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_604" bpmnElement="Flow_604">
        <di:waypoint x="310" y="350"/>
        <di:waypoint x="350" y="350"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_605_Yes" bpmnElement="Flow_605_Yes">
        <di:waypoint x="400" y="350"/>
        <di:waypoint x="520" y="350"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_605_Wait" bpmnElement="Flow_605_Wait">
        <di:waypoint x="400" y="350"/>
        <di:waypoint x="180" y="350"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_606" bpmnElement="Flow_606">
        <di:waypoint x="650" y="350"/>
        <di:waypoint x="690" y="350"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_607" bpmnElement="Flow_607">
        <di:waypoint x="820" y="350"/>
        <di:waypoint x="860" y="350"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
