    "pdfPage": 39,
    "stages": {
      "discovery": "Observes lack of therapeutic effect or unexpected adverse reaction in a treated patient.",
      "reporting": "Opens the digital SF reporting app on clinic computer or mobile phone.",
      "productDetails": "Selects the medicine from the product catalogue or enters product name, batch number, and expiry date.",
      "uploadingPhotos": "Uploads photos of the medicine packaging, vial/blister, and label.",
      "confirmationAndTracking": "Receives immediate confirmation message and unique report tracking number.",
      "followUpAndFeedback": "Receives investigation updates from the NMRA and clinical guidance on affected batches."
    },
