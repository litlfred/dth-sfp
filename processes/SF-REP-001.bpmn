      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_3_EnterProductDetails" bpmnElement="Task_3_EnterProductDetails">
        <dc:Bounds x="860" y="135" width="130" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_4_EnterBatchExpiry" bpmnElement="Task_4_EnterBatchExpiry">
        <dc:Bounds x="1030" y="135" width="130" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_5_SelectReportType" bpmnElement="Task_5_SelectReportType">
        <dc:Bounds x="1200" y="135" width="130" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gw_ReportCategory" bpmnElement="Gw_ReportCategory">
        <dc:Bounds x="1370" y="145" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_6a_SubstandardDetails" bpmnElement="Task_6a_SubstandardDetails">
        <dc:Bounds x="1540" y="135" width="130" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_7a_UploadSubstandardPhotos" bpmnElement="Task_7a_UploadSubstandardPhotos">
        <dc:Bounds x="1710" y="135" width="130" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_6b_FalsifiedDetails" bpmnElement="Task_6b_FalsifiedDetails">
        <dc:Bounds x="1880" y="135" width="130" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_7b_UploadFalsifiedPhotos" bpmnElement="Task_7b_UploadFalsifiedPhotos">
        <dc:Bounds x="2050" y="135" width="130" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gw_ContactInfo" bpmnElement="Gw_ContactInfo">
        <dc:Bounds x="2220" y="145" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_8a_EnterContact" bpmnElement="Task_8a_EnterContact">
        <dc:Bounds x="2390" y="135" width="130" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_8b_RemainAnonymous" bpmnElement="Task_8b_RemainAnonymous">
        <dc:Bounds x="2560" y="135" width="130" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_9_SubmitReport" bpmnElement="Task_9_SubmitReport">
        <dc:Bounds x="2730" y="135" width="130" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_10_ReceiveAndValidate" bpmnElement="Task_10_ReceiveAndValidate">
        <dc:Bounds x="180" y="315" width="130" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_11_SendAcknowledgement" bpmnElement="Task_11_SendAcknowledgement">
        <dc:Bounds x="350" y="315" width="130" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_12_InitialScreening" bpmnElement="Task_12_InitialScreening">
        <dc:Bounds x="520" y="315" width="130" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_SF_REP_001" bpmnElement="End_SF_REP_001">
        <dc:Bounds x="690" y="332" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_01" bpmnElement="Flow_01">
        <di:waypoint x="216" y="170"/>
        <di:waypoint x="350" y="170"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_02" bpmnElement="Flow_02">
        <di:waypoint x="480" y="170"/>
        <di:waypoint x="520" y="170"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_03_Yes" bpmnElement="Flow_03_Yes">
        <di:waypoint x="570" y="170"/>
        <di:waypoint x="860" y="170"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_03_No" bpmnElement="Flow_03_No">
        <di:waypoint x="570" y="170"/>
        <di:waypoint x="690" y="170"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_04a" bpmnElement="Flow_04a">
        <di:waypoint x="820" y="170"/>
        <di:waypoint x="1030" y="170"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_04b" bpmnElement="Flow_04b">
        <di:waypoint x="990" y="170"/>
        <di:waypoint x="1030" y="170"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_05" bpmnElement="Flow_05">
        <di:waypoint x="1160" y="170"/>
        <di:waypoint x="1200" y="170"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_06" bpmnElement="Flow_06">
        <di:waypoint x="1330" y="170"/>
        <di:waypoint x="1370" y="170"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_07_Sub" bpmnElement="Flow_07_Sub">
        <di:waypoint x="1420" y="170"/>
        <di:waypoint x="1540" y="170"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_07_Fal" bpmnElement="Flow_07_Fal">
        <di:waypoint x="1420" y="170"/>
        <di:waypoint x="1880" y="170"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_08a" bpmnElement="Flow_08a">
        <di:waypoint x="1670" y="170"/>
        <di:waypoint x="1710" y="170"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_08b" bpmnElement="Flow_08b">
        <di:waypoint x="2010" y="170"/>
        <di:waypoint x="2050" y="170"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_09a" bpmnElement="Flow_09a">
        <di:waypoint x="1840" y="170"/>
        <di:waypoint x="2220" y="170"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_09b" bpmnElement="Flow_09b">
        <di:waypoint x="2180" y="170"/>
