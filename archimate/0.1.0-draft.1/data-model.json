      "name": "Medical Product Alert",
      "type": "BusinessObject",
      "documentation": "Official notification or alert issued by the NMRA or WHO on confirmed or suspected substandard and falsified medical products to inform health care professionals, supply chain actors, and the public. (Table 6, Table 9, Ch. 7, PDF 32, 39-40, 59)",
      "logicalModel": "MedicalProductAlert",
      "skosConcept": "https://github.com/litlfred/dth-sfp/blob/main/glossary/dth-sfp.glossary.json#medical-product-alert",
      "attributes": [
        {
          "name": "alertIdentifier",
          "type": "Identifier",
          "source": "property"
        },
        {
          "name": "issuingAuthority",
          "type": "Reference(Organization) (NMRA / WHO)",
          "source": "property"
        },
        {
          "name": "affectedProduct",
          "type": "Reference(TradeItem)",
          "source": "property"
        },
        {
          "name": "batchNumbers",
          "type": "string 0..*",
          "source": "property"
        },
        {
          "name": "recommendedAction",
          "type": "string",
          "source": "property"
        }
      ],
      "accessedBy": [
