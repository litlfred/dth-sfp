    {
      "id": "id-753b4997886b5790b4e6153f5835be66",
      "name": "SF Report Data Object",
      "type": "DataObject",
      "documentation": "Structured data record for a substandard and falsified medical product report, comprising the core data elements of Table 11 (SFR.A1.DE1 Region, DE2 Type of report, DE3 Product ID, DE4 Product description, DE5 Type of product, DE6 Batch number, DE7 Expiry date, DE8 Substandard or falsified?, DE9 Adverse reaction or lack of efficacy?, DE10 Reporting reason/description) encoded with HL7 FHIR and standard terminologies (ICD-11, SNOMED GPS). (Section 4.4, Table 11, Table 13, PDF 42-43, 47)",
      "logicalModel": "SFR.A1.DE1..DE10",
      "skosConcept": "https://github.com/litlfred/dth-sfp/blob/main/glossary/dth-sfp.glossary.json#sf-report-data-object",
      "attributes": [
        {
          "name": "SFR.A1.DE1",
          "type": "CodeableConcept 1..1 (Region)",
          "source": "property"
        },
        {
          "name": "SFR.A1.DE2",
          "type": "code 1..1 (Type of report)",
          "source": "property"
        },
        {
          "name": "SFR.A1.DE3",
          "type": "Identifier 1..1 (Product ID)",
          "source": "property"
        },
        {
          "name": "SFR.A1.DE4",
          "type": "string 0..1 (Product description)",
          "source": "property"
        },
        {
          "name": "SFR.A1.DE5",
          "type": "CodeableConcept 1..1 (Type of product)",
          "source": "property"
        },
        {
          "name": "SFR.A1.DE6",
          "type": "string 1..1 (Batch number)",
          "source": "property"
        },
        {
          "name": "SFR.A1.DE7",
          "type": "date 1..1 (Expiry date)",
          "source": "property"
        },
        {
          "name": "SFR.A1.DE8",
          "type": "CodeableConcept 1..1 (Substandard or falsified?)",
          "source": "property"
        },
        {
          "name": "SFR.A1.DE9",
          "type": "boolean 1..1 (Adverse reaction or lack of efficacy?)",
          "source": "property"
        },
        {
          "name": "SFR.A1.DE10",
          "type": "string 1..1 (Reporting reason / description)",
          "source": "property"
        }
      ],
      "accessedBy": [
        {
          "elementId": "id-c7a1fbef2d2e5265ab5ea21bb98324cc",
