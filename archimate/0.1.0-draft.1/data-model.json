    {
      "id": "id-5dc77dae1bce5d11b288830795b31bdf",
      "name": "Traceability Event",
      "type": "DataObject",
      "documentation": "Traceability data. What: product identifier, batch no., serial no. When: date and time of the event. Where: location of the event. Why: details of the transaction (e.g., receiving, shipping, dispensing, discarding). (Fig. 24, PDF 55)",
      "logicalModel": "TraceabilityEvent",
      "attributes": [
        {
          "name": "what",
          "type": "Identifier (GTIN, batch/lot no., serial no.)",
          "source": "property"
        },
        {
          "name": "when",
          "type": "dateTime (event timestamp)",
          "source": "property"
        },
        {
          "name": "where",
          "type": "Location (facility / warehouse GLN)",
          "source": "property"
        },
        {
          "name": "why",
          "type": "code (receiving, shipping, dispensing, discarding)",
          "source": "property"
        }
      ],
      "accessedBy": [
        {
          "elementId": "id-975c5567001151299672c0341a733111",
          "name": "Product Verification",
          "type": "ApplicationService",
          "relationshipId": "id-25d00334b7355e66b67722087d9a16fe",
          "kind": "read"
        }
      ]
    },
