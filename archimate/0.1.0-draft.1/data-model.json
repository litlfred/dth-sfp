          "source": "property"
        },
        {
          "name": "manufacturer",
          "type": "Reference(Organization) 0..1",
          "source": "property"
        },
        {
          "name": "countryOfOrigin",
          "type": "CodeableConcept 1..1",
          "source": "property"
        },
        {
          "name": "shelfLife",
          "type": "Duration 0..1",
          "source": "property"
        },
        {
          "name": "associatedGenericProduct",
          "type": "BackboneElement 0..* (genericProduct 1..1, quantity 1..1)",
          "source": "property"
        },
        {
          "name": "contains",
          "type": "BackboneElement 0..* (tradeItem 1..1, quantity 1..1)",
          "source": "property"
        },
        {
          "name": "attribute",
          "type": "BackboneElement 0..* (type 1..1, value[x] 1..1)",
          "source": "property"
        }
      ],
      "accessedBy": [
        {
          "elementId": "id-edfb9d0b618453f294948f0427a64c9e",
