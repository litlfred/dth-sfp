          "source": "property"
        },
        {
          "name": "status",
          "type": "code 1..1",
          "source": "property"
        },
        {
          "name": "tradeItemName",
          "type": "BackboneElement 0..* (nameType 1..1, name 1..1)",
          "source": "property"
        },
        {
          "name": "description",
          "type": "string 0..1",
          "source": "property"
        },
        {
