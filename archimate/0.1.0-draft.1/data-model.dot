digraph "DTH-SFP overlay on the DPI-H reference architecture — data model" {
  graph [rankdir=LR, fontname="Helvetica", fontsize=11, nodesep=0.5, ranksep=1.1];
  node [shape=box, style="filled", fontname="Helvetica", fontsize=10, margin="0.14,0.08"];
  edge [fontname="Helvetica", fontsize=9, color="#555555", fontcolor="#333333"];
  "id-8436ad35e0bc560ea49d2005a6bda297" [label="«Business Object»\nMedical Product Alert\n[MedicalProductAlert]\n—\n• alertIdentifier: Identifier\n• issuingAuthority: Reference(Organization) (NMRA / WHO)\n• affectedProduct: Reference(TradeItem)\n• batchNumbers: string 0..*\n• recommendedAction: string", fillcolor="#ffffb5", URL="../../en/dth-sfp/archimate/0.1.0-draft.1/element/medical-product-alert/", target="_top", tooltip="Medical Product Alert (Business Object)"];
  "id-ac6852fe91ab574baef07b27aa0bc945" [label="«Business Object»\nSF Report\n[SFReport]\n—\n• productIdentification: Identifier (GTIN / Product ID)\n• batchNumber: string\n• expiryDate: date\n• incidentDescription: string\n• photos: Attachment 0..*\n• trackingStatus: code", fillcolor="#ffffb5", URL="../../en/dth-sfp/archimate/0.1.0-draft.1/element/sf-report/", target="_top", tooltip="SF Report (Business Object)"];
  "id-753b4997886b5790b4e6153f5835be66" [label="«Data Object»\nSF Report Data Object\n[SFR.A1.DE1..DE10]\n—\n• SFR.A1.DE1: CodeableConcept 1..1 (Region)\n• SFR.A1.DE2: code 1..1 (Type of report)\n• SFR.A1.DE3: Identifier 1..1 (Product ID)\n• SFR.A1.DE4: string 0..1 (Product description)\n• SFR.A1.DE5: CodeableConcept 1..1 (Type of product)\n• SFR.A1.DE6: string 1..1 (Batch number)\n• SFR.A1.DE7: date 1..1 (Expiry date)\n• SFR.A1.DE8: CodeableConcept 1..1 (Substandard or falsified?)\n• SFR.A1.DE9: boolean 1..1 (Adverse reaction or lack of efficacy?)\n• SFR.A1.DE10: string 1..1 (Reporting reason / description)", fillcolor="#b5ffff", URL="../../en/dth-sfp/archimate/0.1.0-draft.1/element/sf-report-data-object/", target="_top", tooltip="SF Report Data Object (Data Object)"];
  "id-5dc77dae1bce5d11b288830795b31bdf" [label="«Data Object»\nTraceability Event\n[TraceabilityEvent]\n—\n• what: Identifier (GTIN, batch/lot no., serial no.)\n• when: dateTime (event timestamp)\n• where: Location (facility / warehouse GLN)\n• why: code (receiving, shipping, dispensing, discarding)", fillcolor="#b5ffff", URL="../../en/dth-sfp/archimate/0.1.0-draft.1/element/traceability-event/", target="_top", tooltip="Traceability Event (Data Object)"];
  "id-60e7d1d9e64c5011a1efe8becac406d0" [label="«Business Object»\nTrade Item\n[TradeItem]\n—\n• identifier: Identifier 1..* (GTIN)\n• status: code 1..1\n• tradeItemName: BackboneElement 0..* (nameType 1..1, name 1..1)\n• description: string 0..1\n• classification: CodeableConcept 0..*\n• manufacturer: Reference(Organization) 0..1\n• countryOfOrigin: CodeableConcept 1..1\n• shelfLife: Duration 0..1\n• associatedGenericProduct: BackboneElement 0..* (genericProduct 1..1, quantity 1..1)\n• contains: BackboneElement 0..* (tradeItem 1..1, quantity 1..1)\n• attribute: BackboneElement 0..* (type 1..1, value[x] 1..1)", fillcolor="#ffffb5", URL="../../en/dth-sfp/archimate/0.1.0-draft.1/element/trade-item/", target="_top", tooltip="Trade Item (Business Object)"];
  "id-753b4997886b5790b4e6153f5835be66" -> "id-5dc77dae1bce5d11b288830795b31bdf" [label="DE3 Product ID, DE6 Batch, DE7 Expiry", arrowhead=vee, URL="../../en/dth-sfp/archimate/0.1.0-draft.1/relationship/id-803f78c9a03b5bb294949bccbd13eaae/", target="_top", tooltip="DE3 Product ID, DE6 Batch, DE7 Expiry"];
  "id-753b4997886b5790b4e6153f5835be66" -> "id-60e7d1d9e64c5011a1efe8becac406d0" [label="DE3 Product ID / DE5 Type", arrowhead=vee, URL="../../en/dth-sfp/archimate/0.1.0-draft.1/relationship/id-eef71a1115e75530b1d9d43bef01cfed/", target="_top", tooltip="DE3 Product ID / DE5 Type"];
  "id-753b4997886b5790b4e6153f5835be66" -> "id-ac6852fe91ab574baef07b27aa0bc945" [label="realises", style=dashed, arrowhead=onormal, URL="../../en/dth-sfp/archimate/0.1.0-draft.1/relationship/id-74f05dc8d8fd5248826a9f33ab6bf123/", target="_top", tooltip="realises"];
