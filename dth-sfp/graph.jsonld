s/prose-sec-029","papers/dth-sfp/blocks/tbl-table-18"],"text":"ind-sfp-03.md","meta":{"indicatorId":"SFP.IND.03","name":"Stability measures (system uptime, crash rate and offline sync reliability)","description":"Technical stability of the SF reporting platform, measured by system availability/uptime rate, error/crash frequency, and successful synchronisation rate of offline outbox reports (Table 18, p. 44 / PDF p. 56). No empirical target values are asserted.","numerator":"System operational uptime hours and successfully synchronised reports","denominator":"Total scheduled operational hours and total queued reports","source":"who-iris/library/9789240120747-eng/sections/sec-029-61-develop-a-monitoring-and-evaluation-plan.md","pdfPage":56,"glossary":[{"iri":"https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/monitoring","term":"monitoring"},{"iri":"https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/evaluation","term":"evaluation"},{"iri":"https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/detection-to-notification-time","term":"detection-to-notification-time"},{"iri":"https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/sf-report","term":"sf-report"},{"iri":"https://litlfred.github.io/smart-ra/v0/ns#glossary/dpi-h-ra/outcome","term":"outcome"}],"glossaryTerms":["https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/monitoring","https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/evaluation","https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/detection-to-notification-time","https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/sf-report","https://litlfred.github.io/smart-ra/v0/ns#glossary/dpi-h-ra/outcome"],"archimate":{"model":"0.3.0-draft.1","basis":"agent-proposed by name, for working-group review (litlfred/dth-sfp#1)","elements":[{"iri":"https://litlfred.github.io/smart-ra/archimate/0.3.0-draft.1/elements/id-3fd92d497ca040c8a436f355c0b68770.jsonld","name":"Analytics & Reporting Platform","type":"ApplicationComponent"