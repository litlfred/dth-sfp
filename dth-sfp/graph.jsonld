NREQ.002–009 (assigned IDs, F4): Encrypt data in transit and at rest, support anonymous reporting (DE10), enforce password complexity and session timeouts, and protect against unauthorized access."],"source":"who-iris/library/9789240120747-eng/sections/sec-026-45-gather-requirements.md","pdfPage":44,"reviewNotes":["F4: Only row 1 (SFR.NFXNREQ.001) in Security and confidentiality carries a printed ID in Table 13; remaining rows assigned sequential IDs."],"glossary":[{"iri":"https://litlfred.github.io/smart-ra/v0/ns#glossary/dpi-h-ra/non-functional-requirements","term":"non-functional-requirements"},{"iri":"https://litlfred.github.io/smart-ra/v0/ns#glossary/dpi-h-ra/interoperability","term":"interoperability"},{"iri":"https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/sf-report","term":"sf-report"}],"glossaryTerms":["https://litlfred.github.io/smart-ra/v0/ns#glossary/dpi-h-ra/non-functional-requirements","https://litlfred.github.io/smart-ra/v0/ns#glossary/dpi-h-ra/interoperability","https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/sf-report"],"archimate":{"model":"0.3.0-draft.1","basis":"agent-proposed by name, for working-group review (litlfred/dth-sfp#1)","elements":[{"iri":"https://litlfred.github.io/smart-ra/archimate/0.3.0-draft.1/elements/id-22eff58eae365a4f8d0e0368d8c3497e.jsonld","name":"Regulatory Systems","type":"ApplicationComponent"},{"iri":"https://litlfred.github.io/smart-ra/archimate/0.3.0-draft.1/elements/id-d79aa0eec0584b0792b44bca408afeb6.jsonld","name":"DPI-F Security & Consent Module","type":"ApplicationComponent"},{"iri":"https://litlfred.github.io/smart-ra/archimate/0.3.0-draft.1/elements/id-3c5d846710034c4595e206e748d65e36.jsonld","name":"DPI-F Information Mediator","type":"ApplicationComponent"}],"views":[{"iri":"https://litlfred.github.io/smart-ra/archimate/0.3.0-draft.1/views/id-8c5dd12b8d4e425184f6003d0513d569.jsonld","name":"Interoperability Layer"},{"iri":"https://litlfred.github.io/smart-ra/archimate/0.3.0-draft.1/views/id