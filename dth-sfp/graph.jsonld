serted.","numerator":"Number of submitted SF reports with complete and validated core data elements (DE1–DE10)","denominator":"Total number of SF reports submitted in the reporting period","source":"who-iris/library/9789240120747-eng/sections/sec-029-61-develop-a-monitoring-and-evaluation-plan.md","pdfPage":56,"glossary":[{"iri":"https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/monitoring","term":"monitoring"},{"iri":"https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/evaluation","term":"evaluation"},{"iri":"https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/detection-to-notification-time","term":"detection-to-notification-time"},{"iri":"https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/sf-report","term":"sf-report"},{"iri":"https://litlfred.github.io/smart-ra/v0/ns#glossary/dpi-h-ra/outcome","term":"outcome"}],"glossaryTerms":["https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/monitoring","https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/evaluation","https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/detection-to-notification-time","https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/sf-report","https://litlfred.github.io/smart-ra/v0/ns#glossary/dpi-h-ra/outcome"],"archimate":{"model":"0.3.0-draft.1","basis":"agent-proposed by name, for working-group review (litlfred/dth-sfp#1)","elements":[{"iri":"https://litlfred.github.io/smart-ra/archimate/0.3.0-draft.1/elements/id-3fd92d497ca040c8a436f355c0b68770.jsonld","name":"Analytics & Reporting Platform","type":"ApplicationComponent"},{"iri":"https://litlfred.github.io/smart-ra/archimate/0.3.0-draft.1/elements/id-bbd18f65be45490fbbaf02346511ae5e.jsonld","name":"Reporting Module","type":"ApplicationComponent"},{"iri":"https://litlfred.github.io/smart-ra/archimate/0.3.0-draft.1/elements/id-8e67c8e9e1195cdc857b03a2c640e7fe.jsonld","name":"National Regulatory Authority","type":"BusinessRole"}],"views":[{"iri":"https://litlfred.github.io/smart-ra/archimate/0.3.0-dra