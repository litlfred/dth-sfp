      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/evaluation",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp"
      },
      "skos:prefLabel": [
        {
          "@value": "Evaluation"
        }
      ],
      "skos:definition": [
        {
          "@value": "The systematic and objective assessment of an ongoing or completed project, programme or policy, with the aim of determining the relevance and fulfilment of objectives, development efficiency, effectiveness, impact and sustainability (8)."
        }
      ],
      "skos:scopeNote": "Handbook glossary definition, quoted verbatim (p. vii, PDF p. 9, citing reference 8). Operationalised in Chapter 6 (Tables 16–18).",
