      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/suspect-product",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp"
      },
      "skos:prefLabel": [
        {
          "@value": "Suspect Product"
        }
      ],
      "skos:altLabel": [
        "suspected SF medical product",
        "suspect medical product"
      ],
      "skos:definition": [
        {
          "@value": "A medical product observed with a suspected quality defect, abnormal physical appearance, suspicious packaging or labelling, suspected falsification, or unexpected therapeutic failure/adverse reaction, pending regulatory screening, investigation, or laboratory confirmation."
        }
      ],
      "skos:scopeNote": "Cluster C domain concept (dth-sfp#1 §2.1C). Identified in Table 11 via product name (SFR.A1.DE1), product ID (SFR.A1.DE3), manufacturer (SFR.A1.DE4), type of product (SFR.A1.DE5), batch number (SFR.A1.DE6), and expiry date (SFR.A1.DE7).",
      "skos:broader": [
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/medical-product"
        }
      ],
      "skos:related": [
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/sf-report"
        },
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/substandard-medical-product"
        },
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/falsified-medical-product"
        },
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/unregistered-or-unlicensed-medical-product"
        },
        {
          "@id": "https://litlfred.github.io/dth-sc/v0/ns#glossary/dth-sc/traceability"
        }
      ],
      "skos:broadMatch": [
        {
          "@id": "https://litlfred.github.io/dth-pc/v0/ns#glossary/dth-pc/regulated-trade-item"
        },
        {
          "@id": "https://litlfred.github.io/dth-pc/v0/ns#glossary/dth-pc/trade-item"
        }
      ],
      "dcterms:source": "who-iris/library/9789240120747-eng/sections/sec-024-43-develop-business-processes-and-workflows.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/reporter",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp"
      },
      "skos:prefLabel": [
        {
          "@value": "Reporter"
        }
      ],
      "skos:altLabel": [
        "SF reporter",
        "reporting user"
      ],
      "skos:definition": [
        {
          "@value": "An individual who detects or suspects a substandard or falsified medical product and submits a report to the regulatory authority or reporting system, including health care professionals, patients and members of the public, and supply chain or industry actors."
        }
      ],
      "skos:scopeNote": "Cluster C domain concept (dth-sfp#1 §2.1C). Specialised into user personas across §4.1, Tables 7–9, and Annex 2 (Finding F3: the persona lists across §4.1, Table 7, Table 8, Table 9, and Annex 2 differ and are unioned in the L2 persona set SFP-R-01..SFP-R-15).",
      "skos:related": [
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/sf-report"
        },
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/anonymous-report"
        },
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/reporter-feedback-loop"
        },
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/health-care-professional"
        },
        {
          "@id": "https://litlfred.github.io/dth-hrh/v0/ns#glossary/dth-hrh/health-workers"
        }
      ],
      "skos:broadMatch": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns#glossary/dpi-h-ra/user-persona"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns#glossary/dpi-h-ra/end-user"
        }
      ],
      "dcterms:source": "who-iris/library/9789240120747-eng/sections/sec-022-41-identify-user-personas.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/anonymous-report",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp"
      },
      "skos:prefLabel": [
        {
          "@value": "Anonymous Report"
        }
      ],
      "skos:altLabel": [
        "confidential SF report",
        "unidentified reporter submission"
      ],
      "skos:definition": [
        {
          "@value": "An SF report submitted without personal identifying or contact information (SFR.A1.DE9, SFR.A1.DE10), protecting the reporter from fear of reprisal or liability while preventing direct follow-up communication unless an anonymous tracking channel is used."
        }
      ],
      "skos:scopeNote": "Cluster C domain concept (dth-sfp#1 §2.1C). Highlighted in Table 5 (barriers: fear of reprisal), Table 8 (laboratory technician and pharmacist personas), Fig. 4 (gateway 8: Did user include contact information?), and Table 11 (SFR.A1.DE9, SFR.A1.DE10).",
      "skos:broader": [
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/sf-report"
        }
      ],
      "skos:related": [
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/reporter"
        },
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/tracking-number"
        }
      ],
      "skos:broadMatch": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns#glossary/dpi-h-ra/data-object"
        }
      ],
      "dcterms:source": "who-iris/library/9789240120747-eng/sections/sec-024-43-develop-business-processes-and-workflows.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/therapeutic-failure",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp"
      },
      "skos:prefLabel": [
        {
          "@value": "Therapeutic Failure"
        }
      ],
      "skos:altLabel": [
        "lack of efficacy",
        "treatment failure"
      ],
      "skos:definition": [
        {
          "@value": "Failure of a medical product to produce the expected clinical or therapeutic effect when administered to a patient, which may indicate an inadequate dose of active pharmaceutical ingredient or absence of active ingredient due to a substandard or falsified product."
        }
      ],
      "skos:scopeNote": "Cluster C domain concept (dth-sfp#1 §2.1C). Described in Introduction (p. 1, PDF p. 13) and Table 9 user scenarios (Doctor, Nurse, Midwife, Paramedic) as a primary clinical trigger for suspecting an SF product alongside adverse drug reactions.",
      "skos:related": [
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/adverse-drug-reaction"
        },
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/substandard-medical-product"
        },
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/falsified-medical-product"
        },
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/sf-report"
        }
      ],
      "skos:broadMatch": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns#glossary/dpi-h-ra/data-object"
        }
      ],
      "dcterms:source": "who-iris/library/9789240120747-eng/sections/sec-004-reporting-of-substandard-and-falsified-medical-p.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/tracking-number",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp"
      },
      "skos:prefLabel": [
        {
          "@value": "Tracking Number"
        }
      ],
      "skos:altLabel": [
        "report tracking number",
        "confirmation reference number"
      ],
      "skos:definition": [
        {
          "@value": "A unique identifier automatically generated and returned to the reporter upon submission of an SF report (Table 12, SFR.FXNREQ.003) so the reporter and regulatory authority can reference and monitor the progress of the report."
        }
      ],
      "skos:scopeNote": "Cluster C domain concept (dth-sfp#1 §2.1C). Enables business process SF-REP-002 (Receive, acknowledge and track report) and the reporter feedback loop.",
      "skos:broader": [
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/sf-report"
        }
      ],
      "skos:related": [
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/reporter-feedback-loop"
        }
      ],
      "skos:broadMatch": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns#glossary/dpi-h-ra/data-element"
        }
      ],
      "dcterms:source": "who-iris/library/9789240120747-eng/sections/sec-025-44-outline-data-requirements.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/reporter-feedback-loop",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp"
      },
      "skos:prefLabel": [
        {
          "@value": "Reporter Feedback Loop"
        }
      ],
      "skos:altLabel": [
        "feedback to reporter",
        "status update notification"
      ],
      "skos:definition": [
        {
          "@value": "The bidirectional communication mechanism through which a reporting system acknowledges receipt of an SF report, issues a tracking number, requests supplementary evidence when contact details are provided, and informs the reporter of investigation progress and regulatory outcomes."
        }
      ],
      "skos:scopeNote": "Cluster C domain concept (dth-sfp#1 §2.1C). Addressed across Table 5 (lack of feedback barrier), Table 9 (stages 5 and 6 across all 9 scenarios), Table 10 (SF-REP-001 step 12), and Table 12 (functional requirements 3–5).",
      "skos:broader": [
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/sf-report"
        }
      ],
      "skos:related": [
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/tracking-number"
        },
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/reporter"
        },
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/national-medicines-regulatory-authority"
        }
      ],
      "skos:broadMatch": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns#glossary/dpi-h-ra/business-process"
        }
      ],
      "dcterms:source": "who-iris/library/9789240120747-eng/sections/sec-023-42-define-user-scenarios.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/detection-to-notification-time",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp"
      },
      "skos:prefLabel": [
        {
          "@value": "Detection-to-Notification Time"
        }
      ],
      "skos:altLabel": [
        "time from detection to notification",
        "reporting turnaround time"
      ],
      "skos:definition": [
        {
          "@value": "The elapsed time between initial detection of a suspected substandard or falsified medical product and notification or alert issuance by the regulatory authority, used as a fidelity and timeliness measure for SF reporting systems."
        }
      ],
      "skos:scopeNote": "Cluster C domain concept (dth-sfp#1 §2.1C). Appears in §2.4 strategic goals (p. 16, PDF p. 28; empirical example numbers stay in source prose only) and Table 18 M&E fidelity measures (p. 44, PDF p. 56).",
      "skos:related": [
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/sf-report"
        },
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/monitoring"
        },
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/evaluation"
        }
      ],
      "skos:broadMatch": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns#glossary/dpi-h-ra/outcome"
        }
      ],
      "dcterms:source": "who-iris/library/9789240120747-eng/sections/sec-029-61-develop-a-monitoring-and-evaluation-plan.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/polypharmacy",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp"
      },
      "skos:prefLabel": [
        {
          "@value": "Polypharmacy"
        }
      ],
      "skos:definition": [
        {
          "@value": "Polypharmacy is the concurrent use of multiple medications. Although there is no standard definition, polypharmacy is often defined as the routine use of five or more medications (16). This includes over-the-counter, prescription and/or traditional and complementary medicines used by a patient."
        }
      ],
      "skos:scopeNote": "Handbook glossary definition, quoted verbatim (p. viii, PDF p. 10, citing WHO reference 16). Cluster C domain concept (dth-sfp#1 §2.1C). Finding F3/orphan glossary entry: defined in the front-matter glossary (p. viii) where it relates to confounding clinical assessment of adverse reactions/therapeutic failure, but never used in the handbook body text (pp. 1–59).",
      "skos:related": [
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/adverse-drug-reaction"
        },
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/therapeutic-failure"
        },
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/medical-product"
        }
      ],
      "skos:broadMatch": [
        {
          "@id": "https://litlfred.github.io/dth-pc/v0/ns#glossary/dth-pc/generic-product"
        }
      ],
      "dcterms:source": "who-iris/library/9789240120747-eng/sections/sec-002-glossary.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/substandard-medical-product",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp"
      },
      "skos:prefLabel": [
        {
          "@value": "Substandard Medical Product"
        }
      ],
      "skos:altLabel": [
        "out of specification medical product",
        "substandard product"
      ],
      "skos:definition": [
        {
          "@value": "Substandard medical products are those that are authorized by national regulatory authorities, but fail to meet either national or international quality standards or specifications – or, in some cases, both (9)."
        }
      ],
      "skos:scopeNote": "Handbook glossary definition, quoted verbatim (p. ix, PDF p. 11, citing reference 9). Finding F1 (two definitions in source): the Introduction (p. 1, PDF p. 13, citing WHA70/A70/23 reference 23) defines substandard medical products as: \"Also called 'out of specification', these are authorized medical products that fail to meet either their quality standards or their specifications, or both.\" Both wordings are preserved here without choosing between them.",
      "skos:broader": [
        {
