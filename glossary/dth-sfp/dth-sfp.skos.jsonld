    {
      "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/falsified-medical-product",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp"
      },
      "skos:prefLabel": [
        {
          "@value": "Falsified Medical Product"
        }
      ],
      "skos:altLabel": [
        "falsified product"
      ],
      "skos:definition": [
        {
          "@value": "Medical products that deliberately/fraudulently misrepresent their identity, composition or source (9)."
        }
      ],
      "skos:scopeNote": "Handbook glossary definition, quoted verbatim (p. vii, PDF p. 9, citing reference 9; identical wording on p. 1, PDF p. 13, citing reference 23).",
