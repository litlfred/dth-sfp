      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/enabling-environment",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp"
      },
      "skos:prefLabel": [
        {
          "@value": "Enabling Environment"
        }
      ],
      "skos:definition": [
        {
          "@value": "Attitudes, actions, policies and practices that stimulate and support the effective and efficient functioning of organizations and individuals (8)."
        }
      ],
      "skos:scopeNote": "Handbook glossary definition, quoted verbatim (p. vii, PDF p. 9, citing DIIG reference 8). Assessed in Chapter 1 (DIIG phase 1).",
      "skos:related": [
