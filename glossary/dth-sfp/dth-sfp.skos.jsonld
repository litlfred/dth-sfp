    },
    {
      "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/unregistered-or-unlicensed-medical-product",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp"
      },
      "skos:prefLabel": [
        {
          "@value": "Unregistered or Unlicensed Medical Product"
        }
      ],
      "skos:altLabel": [
        "unregistered medical product",
        "unlicensed medical product"
      ],
      "skos:definition": [
        {
          "@value": "Medical products that have not undergone evaluation and/or approval by the national or regional regulatory authority for the market in which they are marketed/distributed or used, subject to permitted conditions under national or regional regulation and legislation (9)."
        }
      ],
      "skos:scopeNote": "Handbook glossary definition, quoted verbatim (p. ix, PDF p. 11, citing reference 9; also on p. 1, PDF p. 13, citing reference 23). Finding F2: although defined as the third WHO category alongside substandard and falsified products, the Ch. 4 workflow (Fig. 4, p. 30) and data dictionary element SFR.A1.DE8 (Table 11, p. 31) offer only substandard and falsified paths.",
      "skos:broader": [
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/suspect-product"
        }
      ],
