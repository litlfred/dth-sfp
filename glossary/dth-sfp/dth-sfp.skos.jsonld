  "@graph": [
    {
      "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp",
      "@type": "skos:ConceptScheme",
      "skos:prefLabel": "Glossary of the Digital Transformation Handbook for Substandard and Falsified Medical Product Reporting Systems",
      "skos:definition": "Domain terms for substandard and falsified (SF) medical product reporting systems, quoting the WHO handbook (ISBN 978-92-4-012074-7) with L1 page provenance and SKOS mappings into dpi-h-ra (litlfred/smart-ra), dth-sc (litlfred/dth-sc), dth-pc (litlfred/dth-pc), and dth-hrh (litlfred/dth-hrh). General digital health and enterprise architecture terms are held in dpi-h-ra; supply chain and traceability terms in dth-sc; product master data and trade item terms in dth-pc; and health workforce / ISCO-08 occupation terms in dth-hrh.",
      "dcterms:modified": "2026-10-31",
      "dcterms:source": "who-iris/library/9789240120747-eng",
      "dcterms:license": "CC-BY-NC-SA-3.0-IGO"
    },
    {
      "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/sf-report",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp"
      },
      "skos:prefLabel": [
        {
          "@value": "SF Report"
        }
      ],
      "skos:altLabel": [
        "substandard and falsified medical product report",
        "SF medical product report"
      ],
      "skos:definition": [
        {
          "@value": "A structured notification submitted by a health care professional, member of the public or patient, or pharmaceutical supply chain actor to a national medicines regulatory authority (NMRA) or designated surveillance system regarding a medical product suspected of being substandard, falsified, or unregistered."
        }
      ],
      "skos:scopeNote": "Cluster C domain concept (dth-sfp#1 §2.1C). Captures the report data object produced by business process SF-REP-001 (Table 10, p. 29) and defined by core data elements SFR.A1.DE1–SFR.A1.DE10 (Table 11, p. 31).",
      "skos:related": [
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/report-type"
        },
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/suspect-product"
        },
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/reporter"
        },
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/anonymous-report"
        },
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/tracking-number"
        },
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/reporter-feedback-loop"
        },
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/substandard-medical-product"
        },
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/falsified-medical-product"
        }
      ],
      "skos:broadMatch": [
