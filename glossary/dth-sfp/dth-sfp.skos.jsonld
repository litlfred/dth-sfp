      ],
      "skos:definition": [
        {
          "@value": "A dental professional (ISCO-08 code 2261) who administers dental anaesthetics, antimicrobials, and restorative materials, and reports suspected SF dental medicines or devices when observing unexpected clinical failure or product defects."
        }
      ],
      "skos:scopeNote": "Cluster C persona specialization from §4.1 (p. 25) and Table 9 scenario 7 (p. 28; Finding F3: listed in §4.1 and Table 9, omitted from Tables 7–8). Bound to DAK persona `SFP-R-07`.",
