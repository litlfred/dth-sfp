          "@value": "Doctor"
        }
      ],
      "skos:altLabel": [
        "Medical doctor",
        "Physician",
        "ISCO-08 2211",
        "ISCO-08 2212"
      ],
      "skos:definition": [
        {
          "@value": "A medical practitioner (ISCO-08 codes 2211 Generalist medical practitioners, 2212 Specialist medical practitioners) who diagnoses and treats patients, prescribes or administers medicines, and detects and reports suspected SF medical products upon observing unexpected adverse reactions or therapeutic failure."
        }
      ],
      "skos:scopeNote": "Cluster C persona specialization from §4.1 (p. 25), Table 7 (p. 25), and Table 9 scenario 1 (p. 27). Bound to DAK persona `SFP-R-01`.",
