    },
    {
      "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/monitoring",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp"
      },
      "skos:prefLabel": [
        {
          "@value": "Monitoring"
        }
      ],
      "skos:definition": [
        {
          "@value": "The routine tracking and reporting of priority information about a programme or project, its inputs and intended outputs, outcomes and impacts (8)."
        }
      ],
      "skos:scopeNote": "Handbook glossary definition, quoted verbatim (p. viii, PDF p. 10, citing reference 8). Addressed in Chapter 6 (Monitor, evaluate and scale).",
      "skos:related": [
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/evaluation"
        },
