      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/medical-product",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp"
      },
      "skos:prefLabel": [
        {
          "@value": "Medical Product"
        }
      ],
      "skos:altLabel": [
        "health product"
      ],
      "skos:definition": [
        {
          "@value": "A term that includes medicines, vaccines, diagnostics and medical devices (including in vitro diagnostics) (9)."
        }
      ],
      "skos:scopeNote": "Handbook glossary definition, quoted verbatim (p. viii, PDF p. 10, citing reference 9). Finding F10: in smart-ra (dpi-h-ra/product), \"Product\" is an ArchiMate business/contract offering (homonym); in dth-sfp and dth-pc, medical product / generic product / trade item denotes a physical health commodity.",
      "skos:related": [
