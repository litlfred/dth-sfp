    {
      "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/medical-product-alert",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp"
      },
      "skos:prefLabel": [
        {
          "@value": "Medical Product Alert"
        }
      ],
      "skos:altLabel": [
        "WHO Medical Product Alert",
        "rapid alert"
      ],
      "skos:definition": [
        {
          "@value": "An official safety and quality communication issued by a national regulatory authority or WHO to warn health professionals, supply chain actors and the public about confirmed substandard or falsified medical products in circulation and support product recall or quarantine."
        }
      ],
      "skos:scopeNote": "Domain concept from Introduction (p. 1, PDF p. 13), §1.3 (Table 4), and §2.2 ArchiMate business object list in dth-sfp#1.",
      "skos:related": [
