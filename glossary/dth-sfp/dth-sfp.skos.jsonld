    {
      "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/nurse",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp"
