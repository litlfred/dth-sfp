    {
      "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/pharmacovigilance",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp"
      },
      "skos:prefLabel": [
        {
          "@value": "Pharmacovigilance"
        }
      ],
      "skos:altLabel": [
        "PV"
      ],
      "skos:definition": [
        {
          "@value": "The science and activities relating to the detection, assessment, understanding and prevention of adverse effects or any other medicine/vaccine-related problem (15)."
        }
      ],
      "skos:scopeNote": "Handbook glossary definition, quoted verbatim (p. viii, PDF p. 10, citing reference 15).",
      "skos:related": [
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/active-pharmacovigilance"
        },
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/passive-pharmacovigilance"
        },
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/adverse-drug-reaction"
        },
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/post-market-surveillance"
        }
      ],
      "skos:broadMatch": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns#glossary/dpi-h-ra/capability"
        }
      ],
      "dcterms:source": "who-iris/library/9789240120747-eng/sections/sec-002-glossary.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/active-pharmacovigilance",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp"
      },
      "skos:prefLabel": [
        {
          "@value": "Active Pharmacovigilance"
        }
      ],
      "skos:altLabel": [
        "proactive pharmacovigilance",
        "active safety surveillance"
      ],
      "skos:definition": [
        {
          "@value": "Active (or proactive) safety surveillance means that active measures are taken to detect adverse events. This is managed by active follow-up after treatment and the events may be detected by asking patients directly or screening patient records. The most comprehensive method is cohort event monitoring (1)."
        }
      ],
      "skos:scopeNote": "Handbook glossary definition, quoted verbatim (p. vii, PDF p. 9, citing reference 1).",
      "skos:broader": [
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/pharmacovigilance"
        }
      ],
      "skos:related": [
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/passive-pharmacovigilance"
        },
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/adverse-drug-reaction"
        }
      ],
      "skos:broadMatch": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns#glossary/dpi-h-ra/capability"
        }
      ],
      "dcterms:source": "who-iris/library/9789240120747-eng/sections/sec-002-glossary.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/passive-pharmacovigilance",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp"
      },
      "skos:prefLabel": [
        {
          "@value": "Passive Pharmacovigilance"
        }
      ],
      "skos:altLabel": [
        "spontaneous reporting",
        "voluntary reporting"
      ],
      "skos:definition": [
        {
          "@value": "Passive surveillance means that no active measures are taken to look for adverse effects other than the encouragement of health professionals and others to report safety concerns. Reporting is dependent on the initiative and motivation of the potential reporters. This is the most common form of pharmacovigilance. It is commonly referred to as “spontaneous” or “voluntary” reporting (1)."
        }
      ],
      "skos:scopeNote": "Handbook glossary definition, quoted verbatim (p. viii, PDF p. 10, citing reference 1).",
      "skos:broader": [
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/pharmacovigilance"
        }
      ],
      "skos:related": [
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/active-pharmacovigilance"
        },
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/sf-report"
        },
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/reporter"
        }
      ],
      "skos:broadMatch": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns#glossary/dpi-h-ra/capability"
        }
      ],
      "dcterms:source": "who-iris/library/9789240120747-eng/sections/sec-002-glossary.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/adverse-drug-reaction",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp"
      },
      "skos:prefLabel": [
        {
          "@value": "Adverse Drug Reaction"
        }
      ],
      "skos:altLabel": [
        "ADR"
      ],
      "skos:definition": [
        {
          "@value": "A response to a drug that is noxious and unintended, and which occurs at doses normally used in man for the prophylaxis, diagnosis or therapy of disease, or for the modification of physiological function (2)."
        }
      ],
      "skos:scopeNote": "Handbook glossary definition, quoted verbatim (p. vii, PDF p. 9, citing reference 2). Linked to SFR.A1.DE9 (Adverse reaction details) in Table 11.",
      "skos:related": [
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/pharmacovigilance"
        },
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/therapeutic-failure"
        },
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/sf-report"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns#glossary/dpi-h-ra/adverse-events-following-immunization"
        }
      ],
      "skos:broadMatch": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns#glossary/dpi-h-ra/data-object"
        }
      ],
      "dcterms:source": "who-iris/library/9789240120747-eng/sections/sec-002-glossary.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/post-market-surveillance",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp"
      },
      "skos:prefLabel": [
        {
          "@value": "Post-Market Surveillance"
        }
      ],
      "skos:altLabel": [
        "PMS",
        "post-marketing surveillance"
      ],
      "skos:definition": [
        {
          "@value": "The activities of monitoring the quality, safety and efficacy of medical products after they have been registered and marketed (17)."
        }
      ],
      "skos:scopeNote": "Handbook glossary definition, quoted verbatim (p. viii, PDF p. 10, citing reference 17).",
      "skos:related": [
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/risk-based-post-market-surveillance"
        },
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/pharmacovigilance"
        },
        {
          "@id": "https://litlfred.github.io/dth-sc/v0/ns#glossary/dth-sc/traceability"
        }
      ],
      "skos:broadMatch": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns#glossary/dpi-h-ra/capability"
        }
      ],
      "dcterms:source": "who-iris/library/9789240120747-eng/sections/sec-002-glossary.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/risk-based-post-market-surveillance",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp"
      },
      "skos:prefLabel": [
        {
          "@value": "Risk-Based Post-Market Surveillance"
        }
      ],
      "skos:definition": [
        {
          "@value": "An approach to post-market surveillance that prioritizes and allocates resources toward medical products and supply chains that pose the highest potential risks to public health, thereby ensuring efficient and targeted quality monitoring (19)."
        }
      ],
      "skos:scopeNote": "Handbook glossary definition, quoted verbatim (pp. viii–ix, PDF pp. 10–11, citing reference 19).",
      "skos:broader": [
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/post-market-surveillance"
        }
      ],
      "skos:related": [
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/sf-report"
        },
        {
          "@id": "https://litlfred.github.io/dth-sc/v0/ns#glossary/dth-sc/traceability"
        }
      ],
      "skos:broadMatch": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns#glossary/dpi-h-ra/capability"
        }
      ],
      "dcterms:source": "who-iris/library/9789240120747-eng/sections/sec-002-glossary.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/global-surveillance-and-monitoring-system",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp"
      },
      "skos:prefLabel": [
        {
          "@value": "Global Surveillance and Monitoring System"
        }
      ],
      "skos:altLabel": [
        "GSMS",
        "WHO GSMS"
      ],
      "skos:definition": [
        {
          "@value": "A WHO initiative launched in 2013 to improve the quality of reporting of substandard and falsified medical products, assist Member States in investigating incidents, and issue global medical product alerts when necessary (11)."
        }
      ],
      "skos:scopeNote": "Handbook glossary definition, quoted verbatim (p. vii, PDF p. 9, citing reference 11). Target of business process SF-REP-005 (Report confirmed case to WHO GSMS).",
      "skos:related": [
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/member-state-mechanism"
        },
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/national-medicines-regulatory-authority"
        },
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/sf-report"
        },
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/medical-product-alert"
        }
      ],
      "skos:broadMatch": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns#glossary/dpi-h-ra/application-component"
        }
      ],
      "dcterms:source": "who-iris/library/9789240120747-eng/sections/sec-002-glossary.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/member-state-mechanism",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp"
      },
      "skos:prefLabel": [
        {
          "@value": "Member State Mechanism"
        }
      ],
      "skos:altLabel": [
        "WHO Member State Mechanism on Substandard and Falsified Medical Products"
      ],
      "skos:definition": [
        {
          "@value": "A formal mechanism established by the World Health Assembly to promote global collaboration among Member States to prevent, detect and respond to substandard and falsified medical products, protecting public health and enhancing access to quality medical products (13)."
        }
      ],
      "skos:scopeNote": "Handbook glossary definition, quoted verbatim (p. viii, PDF p. 10, citing reference 13).",
      "skos:related": [
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/global-surveillance-and-monitoring-system"
        },
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/national-medicines-regulatory-authority"
        }
      ],
      "skos:broadMatch": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns#glossary/dpi-h-ra/governance"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns#glossary/dpi-h-ra/stakeholder"
        }
      ],
      "dcterms:source": "who-iris/library/9789240120747-eng/sections/sec-002-glossary.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/national-medicines-regulatory-authority",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp"
      },
      "skos:prefLabel": [
        {
          "@value": "National Medicines Regulatory Authority"
        }
      ],
      "skos:altLabel": [
        "NMRA",
        "national regulatory authority",
        "NRA"
      ],
      "skos:definition": [
        {
          "@value": "The national agency responsible for ensuring that pharmaceuticals and other medical products meet standards of quality, safety and efficacy, Including registration, marketing authorization, inspection, post-market surveillance and regulatory enforcement (14)."
        }
      ],
      "skos:scopeNote": "Handbook glossary definition, quoted verbatim (p. viii, PDF p. 10, citing reference 14). Maps to the shared ArchiMate BusinessRole `National Regulatory Authority` (`id-8e67c8e9e1195cdc857b03a2c640e7fe`) in smart-ra.",
      "skos:related": [
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/sf-report"
        },
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/post-market-surveillance"
        },
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/global-surveillance-and-monitoring-system"
        }
      ],
