    {
      "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/report-type",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp"
      },
      "skos:prefLabel": [
        {
          "@value": "Report Type"
        }
      ],
      "skos:altLabel": [
        "type of report",
        "SFR.A1.DE2",
        "SFR.A1.DE8"
      ],
      "skos:definition": [
        {
          "@value": "Classification of an SF report by reporting channel or suspected defect category: in SFR.A1.DE8 (Table 11, p. 31), whether the report originates from a health care professional, the public, or the pharmaceutical industry (manufacturer/importer); in Fig. 4 (p. 30), whether the suspected product is reported as substandard or falsified."
        }
      ],
      "skos:scopeNote": "Cluster C domain concept (dth-sfp#1 §2.1C). Finding F2: the handbook glossary defines unregistered/unlicensed medical products as the third WHO SF category, but Fig. 4 and Table 11 (DE8) only distinguish substandard vs falsified paths. Finding F4: SFR.A1.DE2 (Type of report) has an empty description and data type in Table 11 while SFR.A1.DE8 repeats the label with a three-category value description.",
      "skos:broader": [
        {
          "@id": "https://litlfred.github.io/dth-sfp/v0/ns#glossary/dth-sfp/sf-report"
        }
      ],
