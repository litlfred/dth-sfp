      ],
      "skos:definition": [
        {
          "@value": "A frontline community health provider (Table 8 lists ISCO-08 code 3259; standard ISCO-08 code for Community health workers is 3253) who delivers basic health services and products in community settings and reports suspected SF products observed during home visits or community outreach."
        }
