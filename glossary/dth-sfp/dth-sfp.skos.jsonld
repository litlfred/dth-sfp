      ],
      "skos:altLabel": [
        "HCP",
        "health professional"
      ],
      "skos:definition": [
        {
          "@value": "Individuals with formal training and licensure who provide health care services, such as doctors, nurses, pharmacists, dentists and midwives (12)."
        }
      ],
      "skos:scopeNote": "Handbook glossary definition, quoted verbatim (p. viii, PDF p. 10, citing reference 12). Parent reporter category for clinical personas in §4.1 and Tables 7–9.",
